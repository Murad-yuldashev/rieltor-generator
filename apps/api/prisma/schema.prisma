generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ListingType {
  NEW_BUILD
  SECONDARY
  HOUSE
}

model Agent {
  id       String    @id @default(cuid())
  name     String
  agency   String
  photoUrl String
  phone    String
  telegram String
  listings Listing[]
}

model Listing {
  id          String      @id
  title       String
  /// An Int overflows at 2.1 bn so'm, and a house can cost more than that.
  priceSom    BigInt
  priceUsd    Int
  rooms       Int
  areaM2      Float
  /// Houses have no floor.
  floor       String?
  district    String
  address     String
  landmark    String
  description String
  type        ListingType
  views       Int         @default(0)
  listedAt    DateTime    @db.Date
  agentId     String
  agent       Agent       @relation(fields: [agentId], references: [id])
  images      Image[]

  @@index([type])
}

model Image {
  id        String  @id @default(cuid())
  listingId String
  /// Base path without a variant: "/images/bx-001/01" — used with imageSrcSet() from @rieltor/shared.
  base      String
  /// 1200×630 crop; filled in for the first image only.
  ogUrl     String?
  width     Int
  height    Int
  position  Int
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, position])
}
