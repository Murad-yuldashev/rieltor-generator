generator client {
  provider      = "prisma-client-js"
  /// "native" covers local dev and the Docker image; the RHEL engine is the one
  /// AWS Lambda (and therefore Netlify Functions) loads at runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ListingType {
  NEW_BUILD
  SECONDARY
  HOUSE
  COMMERCIAL
}

/// Which segment a listing belongs to. Orthogonal to ListingType: commercial
/// premises are advertised both ways, and so are flats.
enum Deal {
  SALE
  RENT
}

model Agent {
  id       String    @id @default(cuid())
  name     String
  agency   String
  photoUrl String
  phone    String
  telegram String
  listings Listing[]
}

model Listing {
  id                String             @id
  title             String
  /// An Int overflows at 2.1 bn so'm, and a house can cost more than that.
  /// For a RENT listing this is the price per month.
  priceSom          BigInt
  priceUsd          Int
  /// Commercial premises are not measured in rooms — OLX omits the field too.
  rooms             Int?
  areaM2            Float
  /// Houses have no floor.
  floor             String?
  district          String
  address           String
  landmark          String
  description       String
  type              ListingType
  /// The ten listings that predate this column were all sales.
  deal              Deal               @default(SALE)
  views             Int                @default(0)
  listedAt          DateTime           @db.Date
  agentId           String
  agent             Agent              @relation(fields: [agentId], references: [id])
  images            Image[]
  /// Null for the seeded demo rows, which predate accounts.
  ownerId           String?
  owner             User?              @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  /// Seeded demo rows are published; anything a user creates starts as DRAFT.
  status            ListingStatus      @default(PUBLISHED)
  rejectionReason   String?
  publishedAt       DateTime?
  notes             Note[]
  collectionItems   CollectionItem[]
  presentationItems PresentationItem[]

  @@index([type])
  @@index([deal])
  @@index([ownerId])
  @@index([status])
}

enum ListingStatus {
  DRAFT
  MODERATION
  PUBLISHED
  REJECTED
  ARCHIVED
}

model Image {
  id        String  @id @default(cuid())
  listingId String
  /// Base path without a variant: "/images/bx-001/01" — used with imageSrcSet() from @rieltor/shared.
  base      String
  /// 1200×630 crop; filled in for the first image only.
  ogUrl     String?
  width     Int
  height    Int
  position  Int
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, position])
}

enum UserRole {
  USER
  REALTOR
  DEVELOPER
  MODERATOR
  ADMIN
}

model User {
  id                String            @id @default(cuid())
  /// E.164 without the plus: "998901234567". Unique across the platform.
  phone             String            @unique
  name              String?
  /// Telegram numeric id, present only when the account was created via Telegram Login.
  telegramId        String?           @unique
  photoUrl          String?
  role              UserRole          @default(USER)
  createdAt         DateTime          @default(now())
  sessions          Session[]
  listings          Listing[]
  savedSearches     SavedSearch[]
  trackedProperties TrackedProperty[]
  notifications     Notification[]
  propertyRequests  PropertyRequest[]
  claimedLeads      PropertyRequest[] @relation("ClaimedLeads")
  realtorProfile    RealtorProfile?
  subscription      Subscription?
  notes             Note[]
  collections       Collection[]
  presentations     Presentation[]
  receivedReviews   Review[]          @relation("ReceivedReviews")
  writtenReviews    Review[]          @relation("WrittenReviews")
  wallet            Wallet?
  memberships       Membership[]
  bookings          Booking[]
}

model Session {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the refresh token. The raw token never touches the database.
  refreshHash String   @unique
  userAgent   String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([userId])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  /// SHA-256 of the six digits, same reasoning as Session.refreshHash.
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

/// One row per phone reveal — the reveal event itself is the lead, not a form submission.
model ContactReveal {
  id        String   @id @default(cuid())
  listingId String?
  requestId String?
  /// Null for anonymous visitors — most reveals will be anonymous.
  userId    String?
  ip        String
  createdAt DateTime @default(now())

  @@index([listingId, createdAt])
  @@index([requestId, createdAt])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  /// The search page's query string, replayed verbatim when the user opens it.
  query     String
  createdAt DateTime @default(now())

  @@index([userId])
}

model TrackedProperty {
  id        String          @id @default(cuid())
  ownerId   String
  owner     User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  label     String?
  type      ListingType
  district  String
  rooms     Int?
  areaM2    Float
  floor     String?
  createdAt DateTime        @default(now())
  snapshots PriceSnapshot[]

  @@index([ownerId])
}

enum SnapshotSource {
  MODELED
  ACTUAL
}

model PriceSnapshot {
  id                String          @id @default(cuid())
  trackedPropertyId String
  trackedProperty   TrackedProperty @relation(fields: [trackedPropertyId], references: [id], onDelete: Cascade)
  estimateSom       BigInt
  capturedAt        DateTime        @db.Date
  source            SnapshotSource

  @@index([trackedPropertyId, capturedAt])
}

enum NotificationType {
  PRICE_UPDATE
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  targetId  String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
}

enum RequestStatus {
  OPEN
  CLOSED
  CLAIMED
  EXPIRED
}

enum LeadOutcomeStage {
  NEW
  CONTACTED
  MEETING
  WON
  LOST
}

enum LeadLostReason {
  NO_RESPONSE
  WRONG_NUMBER
  NOT_SERIOUS
  BOUGHT_ELSEWHERE
  OTHER
}

model PropertyRequest {
  id          String        @id @default(cuid())
  authorId    String
  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  deal        Deal
  type        ListingType?
  district    String?
  roomsMin    Int?
  priceMaxSom BigInt?
  areaMinM2   Float?
  note        String?
  status      RequestStatus @default(OPEN)
  score       Int           @default(0)
  priceSom    BigInt        @default(0)
  claimedById String?
  claimedBy   User?         @relation("ClaimedLeads", fields: [claimedById], references: [id], onDelete: SetNull)
  claimedAt   DateTime?
  createdAt   DateTime      @default(now())

  outcomeStage     LeadOutcomeStage?
  lostReason       LeadLostReason?
  outcomeUpdatedAt DateTime?

  /// Marketplace inquiry provenance (5.3): which complex/unit the lead came from.
  complexId String?
  complex   Complex? @relation("ComplexInquiries", fields: [complexId], references: [id], onDelete: SetNull)
  unitId    String?
  unit      Unit?    @relation("UnitInquiries", fields: [unitId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([deal, type, outcomeStage])
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
}

model RealtorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency          String
  bio             String?
  regions         String[]
  experienceYears Int?
  slug            String?  @unique
  verified        Boolean  @default(false)
  logoUrl         String?
  brandColor      String?
  ratingSum       Int      @default(0)
  ratingCount     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Subscription {
  id               String             @id @default(cuid())
  userId           String             @unique
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           SubscriptionStatus @default(TRIAL)
  tier             String             @default("PRO")
  currentPeriodEnd DateTime
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model Note {
  id        String   @id @default(cuid())
  realtorId String
  realtor   User     @relation(fields: [realtorId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([realtorId, listingId])
}

model Collection {
  id        String           @id @default(cuid())
  realtorId String
  realtor   User             @relation(fields: [realtorId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  items     CollectionItem[]
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  listingId    String
  listing      Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  position     Int
  note         String?
  addedAt      DateTime   @default(now())

  @@unique([collectionId, listingId])
}

model Presentation {
  id                 String             @id @default(cuid())
  realtorId          String
  realtor            User               @relation(fields: [realtorId], references: [id], onDelete: Cascade)
  token              String             @unique
  title              String
  clientLabel        String?
  sourceCollectionId String?
  createdAt          DateTime           @default(now())
  items              PresentationItem[]
  views              PresentationView[]
}

model PresentationItem {
  id             String       @id @default(cuid())
  presentationId String
  presentation   Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  listingId      String
  listing        Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  position       Int
  note           String?
}

model PresentationView {
  id             String       @id @default(cuid())
  presentationId String
  presentation   Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  listingId      String?
  durationMs     Int?
  at             DateTime     @default(now())

  @@index([presentationId])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id        String       @id @default(cuid())
  realtorId String
  realtor   User         @relation("ReceivedReviews", fields: [realtorId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation("WrittenReviews", fields: [authorId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([realtorId, authorId])
  @@index([realtorId, status])
  @@index([status, createdAt])
}

model Wallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Cached truth; equals the sum of transactions. Written in the same tx as the ledger.
  balanceSom   BigInt              @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  transactions WalletTransaction[]
}

enum WalletTxType {
  /// Balance credited (test-payment stub).
  TOPUP
  /// Balance debited to claim a lead.
  LEAD_CLAIM
}

model WalletTransaction {
  id        String       @id @default(cuid())
  walletId  String
  wallet    Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type      WalletTxType
  /// Always positive; `type` gives the direction.
  amountSom BigInt
  /// The claimed PropertyRequest, for LEAD_CLAIM.
  leadId    String?
  createdAt DateTime     @default(now())

  @@index([walletId, createdAt])
}

/// Developer (застройщик) organization roles. A member is either the OWNER
/// (created the org) or a MANAGER (invited later — deferred past 5.1).
enum OrgRole {
  OWNER
  MANAGER
}

enum ComplexStatus {
  PLANNED
  UNDER_CONSTRUCTION
  DONE
}

enum UnitStatus {
  AVAILABLE
  BOOKED
  SOLD
}

enum BookingStatus {
  ACTIVE // holding the unit now
  CANCELLED // released by the developer (cancelReason set)
  EXPIRED // holdUntil passed; freed by the cron
  CONVERTED // turned into a sale (unit -> SOLD)
}

/// Marketplace publish state for a Complex (5.3). DRAFT stays private to the
/// org; PUBLISHED appears on the public marketplace.
enum ComplexPublishStatus {
  DRAFT
  PUBLISHED
}

model Organization {
  id        String       @id @default(cuid())
  name      String
  /// Tashkent district (marketplace list); optional at 5.1.
  district  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  members   Membership[]
  complexes Complex[]

  /// Marketplace trust (5.3): a moderator flips `verified` on after review.
  verified                Boolean   @default(false)
  verificationRequestedAt DateTime?
  verifiedAt              DateTime?
  verificationNote        String?
}

model Membership {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// 5.1: one org per user.
  userId    String       @unique
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      OrgRole      @default(OWNER)
  createdAt DateTime     @default(now())

  @@unique([orgId, userId])
  @@index([orgId])
}

model Complex {
  id          String        @id @default(cuid())
  orgId       String
  org         Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  district    String
  address     String?
  description String?
  status      ComplexStatus @default(UNDER_CONSTRUCTION)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  buildings   Building[]

  /// Marketplace publishing (5.3).
  slug          String?              @unique
  publishStatus ComplexPublishStatus @default(DRAFT)
  publishedAt   DateTime?
  latitude      Float?
  longitude     Float?
  images        ComplexImage[]
  inquiries     PropertyRequest[]    @relation("ComplexInquiries")

  @@index([orgId])
}

model ComplexImage {
  id        String   @id @default(cuid())
  complexId String
  complex   Complex  @relation(fields: [complexId], references: [id], onDelete: Cascade)
  /// Base path without a variant — used with imageSrcSet() from @rieltor/shared.
  base      String
  ogUrl     String?
  width     Int
  height    Int
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([complexId])
}

model Building {
  id        String   @id @default(cuid())
  complexId String
  complex   Complex  @relation(fields: [complexId], references: [id], onDelete: Cascade)
  name      String
  /// Total floor count (helps the 5.2 shaxmatka).
  floors    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  units     Unit[]

  @@index([complexId])
}

model Unit {
  id         String            @id @default(cuid())
  buildingId String
  building   Building          @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  /// Unit number/label, e.g. "42".
  number     String
  floor      Int
  rooms      Int?
  areaM2     Float?
  /// BigInt money, string end-to-end.
  priceSom   BigInt?
  status     UnitStatus        @default(AVAILABLE)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  bookings   Booking[]
  inquiries  PropertyRequest[] @relation("UnitInquiries")

  @@index([buildingId])
}

model Booking {
  id           String        @id @default(cuid())
  unitId       String
  unit         Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  clientName   String
  clientPhone  String
  holdUntil    DateTime
  status       BookingStatus @default(ACTIVE)
  note         String?
  cancelReason String? // set when status = CANCELLED
  createdById  String // the org member who booked (a User id)
  createdBy    User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([unitId])
  @@index([status, holdUntil]) // the expiry cron scans ACTIVE + overdue
}
