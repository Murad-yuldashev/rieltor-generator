generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ListingType {
  NEW_BUILD
  SECONDARY
  HOUSE
}

model Agent {
  id       String    @id @default(cuid())
  name     String
  agency   String
  photoUrl String
  phone    String
  telegram String
  listings Listing[]
}

model Listing {
  id          String      @id
  title       String
  /// Int 2.1 mlrd so'mda to'lib qoladi — hovli undan qimmat bo'lishi mumkin.
  priceSom    BigInt
  priceUsd    Int
  rooms       Int
  areaM2      Float
  /// Hovlida qavat bo'lmaydi.
  floor       String?
  district    String
  address     String
  landmark    String
  description String
  type        ListingType
  views       Int         @default(0)
  listedAt    DateTime    @db.Date
  agentId     String
  agent       Agent       @relation(fields: [agentId], references: [id])
  images      Image[]

  @@index([type])
}

model Image {
  id        String  @id @default(cuid())
  listingId String
  /// Variantsiz asos yo'l: "/images/bx-001/01" — @rieltor/shared imageSrcSet() bilan ishlatiladi.
  base      String
  /// 1200×630 crop; faqat birinchi rasmda to'ldiriladi.
  ogUrl     String?
  width     Int
  height    Int
  position  Int
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, position])
}
