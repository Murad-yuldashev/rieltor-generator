generator client {
  provider = "prisma-client-js"
  /// "native" covers local dev and the Docker image; the RHEL engine is the one
  /// AWS Lambda (and therefore Netlify Functions) loads at runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ListingType {
  NEW_BUILD
  SECONDARY
  HOUSE
  COMMERCIAL
}

/// Which segment a listing belongs to. Orthogonal to ListingType: commercial
/// premises are advertised both ways, and so are flats.
enum Deal {
  SALE
  RENT
}

model Agent {
  id       String    @id @default(cuid())
  name     String
  agency   String
  photoUrl String
  phone    String
  telegram String
  listings Listing[]
}

model Listing {
  id          String      @id
  title       String
  /// An Int overflows at 2.1 bn so'm, and a house can cost more than that.
  /// For a RENT listing this is the price per month.
  priceSom    BigInt
  priceUsd    Int
  /// Commercial premises are not measured in rooms — OLX omits the field too.
  rooms       Int?
  areaM2      Float
  /// Houses have no floor.
  floor       String?
  district    String
  address     String
  landmark    String
  description String
  type        ListingType
  /// The ten listings that predate this column were all sales.
  deal        Deal        @default(SALE)
  views       Int         @default(0)
  listedAt    DateTime    @db.Date
  agentId     String
  agent       Agent       @relation(fields: [agentId], references: [id])
  images      Image[]

  @@index([type])
  @@index([deal])
}

model Image {
  id        String  @id @default(cuid())
  listingId String
  /// Base path without a variant: "/images/bx-001/01" — used with imageSrcSet() from @rieltor/shared.
  base      String
  /// 1200×630 crop; filled in for the first image only.
  ogUrl     String?
  width     Int
  height    Int
  position  Int
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, position])
}
