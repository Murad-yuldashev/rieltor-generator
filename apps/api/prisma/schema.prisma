generator client {
  provider      = "prisma-client-js"
  /// "native" covers local dev and the Docker image; the RHEL engine is the one
  /// AWS Lambda (and therefore Netlify Functions) loads at runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ListingType {
  NEW_BUILD
  SECONDARY
  HOUSE
  COMMERCIAL
}

/// Which segment a listing belongs to. Orthogonal to ListingType: commercial
/// premises are advertised both ways, and so are flats.
enum Deal {
  SALE
  RENT
}

enum ListingStatus {
  DRAFT
  PENDING
  ACTIVE
  RESERVED
  SOLD
  RENTED
  ARCHIVED
}

/// VIEW: page open. CALL_CLICK/TG_CLICK: the two contact CTAs on a listing page.
enum EventType {
  VIEW
  CALL_CLICK
  TG_CLICK
}

/// Forward-only lifecycle: NEW → CONTACTED → MEETING → CLOSED, or straight to
/// CLOSED from any status. @rieltor/shared's nextLeadStatuses() is the single
/// source of truth for which moves are legal (stage 5, spec §8.4).
enum LeadStatus {
  NEW
  CONTACTED
  MEETING
  CLOSED
}

model Agent {
  id       String    @id @default(cuid())
  name     String
  agency   String
  photoUrl String
  phone    String
  telegram String
  listings Listing[]
  /// Reverse side of Realtor.agent. No column is added here — the foreign key
  /// lives on Realtor; Prisma just requires both ends of a relation to be declared.
  realtor  Realtor?
}

model Listing {
  id               String         @id @default(cuid())
  title            String
  /// An Int overflows at 2.1 bn so'm, and a house can cost more than that.
  /// For a RENT listing this is the price per month.
  priceSom         BigInt
  priceUsd         Int
  /// Commercial premises are not measured in rooms — OLX omits the field too.
  rooms            Int?
  areaM2           Float
  /// Houses have no floor.
  floor            String?
  district         String
  address          String
  landmark         String
  description      String
  type             ListingType
  /// The ten listings that predate this column were all sales.
  deal             Deal           @default(SALE)
  /// Lifecycle. The seed listings predate this column and default to ACTIVE, so
  /// they keep showing on the public feed exactly as before.
  status           ListingStatus  @default(ACTIVE)
  /// The owning realtor. NULL for the seed listings, which have no cabinet owner.
  realtorId        String?
  realtor          Realtor?       @relation(fields: [realtorId], references: [id])
  /// Set the moment the listing first goes ACTIVE. Drives expiresAt and the cron.
  publishedAt      DateTime?
  /// publishedAt + 30 days; the stage-4 cron archives listings past this.
  expiresAt        DateTime?
  /// When it became SOLD or RENTED — drives "SOTILDI · N kunda".
  soldAt           DateTime?
  /// Admin's reason when a PENDING listing is rejected back to DRAFT (stage 4).
  moderationNote   String?
  /// expiresAt − 3 days reached and the realtor already notified — set once so the
  /// stage-4 cron never sends the reminder twice.
  expiryNotifiedAt DateTime?
  /// WGS84. Nullable: a listing without a pin still shows everywhere it did before,
  /// and stage 2's draft form saves before the realtor places one.
  lat              Float?
  lng              Float?
  views            Int            @default(0)
  listedAt         DateTime       @db.Date
  agentId          String
  agent            Agent          @relation(fields: [agentId], references: [id])
  images           Image[]
  priceHistory     PriceHistory[]
  shareLinks       ShareLink[]
  events           Event[]
  leads            Lead[]

  @@index([type])
  @@index([deal])
  @@index([status])
  @@index([realtorId])
}

model Image {
  id        String  @id @default(cuid())
  listingId String
  /// Base path without a variant: "/images/bx-001/01" — used with imageSrcSet() from @rieltor/shared.
  base      String
  /// 1200×630 crop; filled in for the first image only.
  ogUrl     String?
  width     Int
  height    Int
  position  Int
  /// Perceptual average-hash (64-bit hex). Written by the stage-2b upload pipeline;
  /// comparison and dupFlag are out of scope until a later spec.
  phash     String?
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, position])
}

/// A realtor who signs in with Telegram and manages their own listings.
/// The public-facing card on a listing page still comes from Agent — see
/// syncAgent() in stage 2, which mirrors this profile into an Agent row.
model Realtor {
  id            String    @id @default(cuid())
  /// Telegram user id. Bigger than a 32-bit int, hence BigInt.
  tgId          BigInt    @unique
  tgUsername    String?
  name          String
  photoUrl      String?
  /// Required before publishing — enforced by the API, not by the schema, so a
  /// half-filled profile can still be saved.
  phone         String?
  /// Set to true when the realtor shares their contact through the bot (stage 5).
  phoneVerified Boolean   @default(false)
  agency        String?
  /// Slug for /r/:username — [a-z0-9-]{3,30}.
  username      String    @unique
  /// Realtor registry number. Optional and never verified.
  registryNo    String?
  /// Once true, this realtor's listings go live without moderation.
  trusted       Boolean   @default(false)
  /// The mirrored public Agent row; created on first publish (stage 2).
  agentId       String?   @unique
  agent         Agent?    @relation(fields: [agentId], references: [id])
  createdAt     DateTime  @default(now())
  /// The realtor's own listings (reverse of Listing.realtor).
  listings      Listing[]
}

/// A realtor-generated tracking link for one listing — e.g. one per Telegram
/// channel or group they post it to. code is what shows up as ?s= on the public
/// listing URL; Event.shareCode copies it for attribution (stage 3, spec §8.1).
model ShareLink {
  id        String   @id @default(cuid())
  /// 6-char base62, generated by the API (node:crypto) — not a DB default.
  code      String   @unique
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  /// Realtor-given name for the channel: "kanalim", "guruh A"...
  label     String?
  createdAt DateTime @default(now())

  @@index([listingId])
}

/// A tracked page view or CTA click, deduplicated per (ipHash, listingId, type)
/// within a 10-minute window (stage 3, spec §8.2). Runs alongside — and does not
/// replace — the existing Listing.views counter from POST /api/view/:id.
model Event {
  id        String    @id @default(cuid())
  listingId String
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  type      EventType
  /// Copy of ShareLink.code, not a FK — stats survive even after the link row
  /// (or the whole ShareLink) is gone.
  shareCode String?
  /// Raw IP is never stored — only a hash salted with the UTC day (spec §8.2).
  ipHash    String
  createdAt DateTime  @default(now())

  @@index([listingId, createdAt])
  @@index([ipHash, listingId, type, createdAt])
}

/// A visitor's "leave your number" submission on a listing page (stage 5, spec
/// §8.4). ipHash powers both the 1-per-hour anti-spam window and, together with
/// notifiedAt, the 24-hour "still NEW" reminder the daily cron sends once.
model Lead {
  id         String     @id @default(cuid())
  listingId  String
  listing    Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  name       String
  phone      String
  status     LeadStatus @default(NEW)
  /// Raw IP is never stored — only a hash salted with the UTC day (spec §8.2), same as Event.
  ipHash     String
  /// Stamped once the 24h-stale reminder is sent, so the cron never repeats it.
  notifiedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([listingId, createdAt])
  @@index([ipHash, listingId, createdAt])
}

/// The price a listing carried right before a change — written by
/// ListingsWriteService.update() before it applies a new priceSom/priceUsd (stage 4,
/// spec §7.6). Read back only as a 7-day window to flag the "price dropped" badge.
model PriceHistory {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  priceSom  BigInt
  priceUsd  Int
  changedAt DateTime @default(now())

  @@index([listingId, changedAt])
}

/// One row per calendar day — the USD/UZS rate fetched from CBU's public JSON API by
/// the stage-4 daily cron. A fetch failure leaves yesterday's row as the latest, which
/// is exactly the fallback ListingsWriteService.update() and the cron rely on.
model FxRate {
  date      DateTime @id @db.Date
  usdRate   Float
  fetchedAt DateTime @default(now())
}
