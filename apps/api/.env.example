DATABASE_URL=postgresql://rieltor:rieltor@localhost:5432/rieltor
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# Seed uchun — o'z kontaktingni qo'y, so'ng `yarn workspace @rieltor/api seed`
SEED_AGENT_TEL=+998901234567
SEED_AGENT_TG=username

# --- Kabinet (ixtiyoriy) ---
# Berilmasa sayt avvalgidek ishlaydi, faqat rieltor kabineti o'chadi.
# BotFather'dan olingan token; widget domeni ham o'sha yerda ro'yxatdan o'tkaziladi.
TELEGRAM_BOT_TOKEN=
# Sessiya cookie'sini imzolaydi, kamida 16 belgi: openssl rand -hex 32
JWT_SECRET=
# Admin endpointlari uchun, kamida 16 belgi
ADMIN_TOKEN=
# Faqat lokal dev va e2e uchun: POST /api/auth/dev ni yoqadi (prodda e'tiborsiz qoldiriladi)
DEV_LOGIN_SECRET=
# Event.ipHash uchun tuz (ixtiyoriy) — berilmasa tuzsiz hash ishlatiladi, sayt yiqilmaydi
IP_HASH_SECRET=
# POST /api/internal/cron/daily uchun, kamida 16 belgi — berilmasa endpoint 503 qaytaradi
CRON_SECRET=

# --- Media / Cloudflare R2 (ixtiyoriy, hali ishlatilmaydi) ---
# Berilmasa rasm yuklash lokal diskka yozadi: apps/api/public/images/<obyekt-id>/.
# Beshtasi ham to'ldirilsagina R2Storage ishga tushadi (hozircha TODO stub).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# Rasmlar R2'dan xizmat qiladigan ommaviy manzil, masalan https://media.example.com
# MEDIA_PUBLIC_URL=
